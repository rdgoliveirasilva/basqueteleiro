# ---- Backend ----
APP_ENV=dev
LOG_LEVEL=INFO
# Lista separada por vírgula
CORS_ORIGINS=http://localhost:5173

# Identifique seu projeto: boa prática (e educação) ao raspar/consumir sites de terceiros
USER_AGENT=basqueteleiro/0.1 (+https://github.com/SEU-USUARIO/basqueteleiro)
HTTP_TIMEOUT=10
HTTP_RETRIES=3

# Requisições por segundo, por host
NBA_RATE=2
LNB_RATE=0.5

# TTL de cache (segundos)
CACHE_TTL_LIVE=15
CACHE_TTL_SCHEDULE=3600
CACHE_TTL_STANDINGS=900
CACHE_TTL_LNB=60
